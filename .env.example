# Copy to .env to override any default from app/config.py.

DATABASE_URL=postgresql+asyncpg://events:events@postgres:5432/events
REDIS_URL=redis://redis:6379/0

LOG_LEVEL=INFO

# Consumer tuning
BATCH_SIZE=100
CONCURRENCY=32
MAX_ATTEMPTS=3
MAX_DELIVERIES=5
RECLAIM_IDLE_MS=30000

# Set to e.g. 0.3 to make 30% of rate lookups fail and watch retries/backoff.
RATES_FAILURE_RATE=0.0

# Host-side port mappings (only used by docker-compose.yml).
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
